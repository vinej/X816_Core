; ============================================================================
; x816_contract.inc -- the X816 contract constants, for ca65.
;
; GENERATED BY tools/contract.py -- DO NOT EDIT.
; Edit X816_core/tools/contract.py and run:  python tools/contract.py --write
;
; ca65 has no preprocessor, so this is .included and the symbols are plain
; equates. boot.s is the consumer: it is the code that decides which image
; owns the machine, so it is the last place a stale address should live.
;
; Changing a value here changes boot.hex, which is baked into the bitstream
; by $readmemh -- boot/build.sh touches rtl/boot_rom.sv for exactly that
; reason. Wiring boot.s to this file did NOT change boot.hex; that was
; checked byte for byte before it was committed.
; ============================================================================

.ifndef X816_CONTRACT_INC
X816_CONTRACT_INC = 1

; ---- Image and load contract
X816_PROG_BASE      = $010000      ; loadable program image: OSD 'Load Image' and boot1.rom
X816_PROG_ENTRY     = $010004      ; PROG_BASE + 4 -- the jmp in the image's own header
X816_FW_BASE        = $F00000      ; resident kernel firmware image, boot2.rom (doc/KERNEL.md 3)
X816_FW_ENTRY       = $F00004      ; FW_BASE + 4
X816_FW_FIRST_BANK  = $F0          ; banks $F0-$FF are the firmware region, write-protected
X816_MAGIC_0        = $58
X816_MAGIC_1        = $38
X816_MAGIC_2        = $31
X816_MAGIC_3        = $36
X816_MAGIC_LE32     = $36313858    ; the same four bytes as one little-endian 32-bit read
X816_IOCTL_PROG     = $0040        ; MiSTer ioctl_index for boot1.rom (a program image)
X816_IOCTL_FW       = $0080        ; MiSTer ioctl_index for boot2.rom (the kernel firmware)
X816_IOCTL_OSD_SLOT = $01          ; ioctl_index[5:0] for an OSD file pick
X816_EXEC_STAGE     = $100000      ; where `run` parks an image before relocating it over PROG_BASE
X816_EXEC_MAX       = $FF00        ; largest image exec.s's single-pass copy can move (X is 16 bits)

; ---- Kernel ABI -- table, context and error codes
KERN_TABLE      = $00FE00          ; 64 entries of `jmp long:`, one page
KERN_ENTRIES    = 64               ; entries in the table
KERN_ENTRY_SIZE = 4                ; bytes per entry -- a jmp long:
KERN_TABLE_END  = $00FEFF          ; last byte of the table page
KERN_DP         = $2000            ; the kernel's direct page; KENTER switches D here
KERN_STATE      = $2000            ; start of the kernel's bank-0 claim (KERNEL.md 3.1)
KERN_STATE_END  = $2FFF            ; last byte of the claim

; ---- VERA2 framebuffer
X816_VFB_BASE = $E00000            ; first byte of the framebuffer region
X816_VFB_LAST = $EFFFFF            ; last byte, inclusive -- one byte below X816_FW_BASE
X816_VFB_SIZE = $100000            ; 1 MB
X816_VFB_BANK = $E0                ; the bank map_addr() decodes on (VFB_BASE >> 16)

; ---- VERA2 bitmap layer
X816_VERA2_BASE      = $9F60       ; CTRL; the block runs to $9F6F
X816_VERA2_ID        = $9F61       ; reads X816_VERA2_ID_VALUE
X816_VERA2_ID_VALUE  = $B5         ; feature-detect signature
X816_VERA2_DISPL     = $9F62       ; display base [7:0]; bit 0 reads 0
X816_VERA2_DISPM     = $9F63       ; display base [15:8]
X816_VERA2_DISPH     = $9F64       ; display base [19:16]
X816_VERA2_PALADR    = $9F66       ; palette index, auto-increments
X816_VERA2_PALLO     = $9F67       ; {G,B} latched
X816_VERA2_PALHI     = $9F68       ; {-,R}; commits the entry, idx++
X816_VERA2_MODE_8BPP = 1           ; CTRL[2:1] = 1: 640x480 256-colour
X816_VERA2_MODE_4BPP = 2           ; CTRL[2:1] = 2: 640x480 16-colour

; ---- MEM_ALLOC arena
X816_HEAP_TABLE  = $200000         ; one page of kernel bookkeeping, never handed out
X816_HEAP_BASE   = $200100         ; first byte MEM_ALLOC may return
X816_HEAP_END    = $DFFFFF         ; last byte of the arena, inclusive -- stops below the VERA2 framebuffer
X816_HEAP_GRAIN  = $100            ; allocations are rounded up, and start, on a page
X816_HEAP_BLOCKS = 32              ; live allocations at once -- a fixed table, not a free list

; ---- Kernel error codes
KERR_NOSYS    = 1                  ; call number not implemented in this build
KERR_NOTFOUND = 2
KERR_NOSPACE  = 3
KERR_BADARG   = 4
KERR_IO       = 5
KERR_EXISTS   = 6
KERR_NOTEMPTY = 7

; ---- I/O page, bank $00 page $9F
X816_IO_PAGE        = $9F00        ; bank $00 only
X816_VIA1           = $9F00
X816_VIA2           = $9F10
X816_VERA           = $9F20        ; $9F20-$9F3F
X816_YM             = $9F40
X816_SYSCTL         = $9F80        ; bit 0 boot overlay, bit 1 E flag (r/o)
X816_SYSCTL_LAST    = $9F8F        ; end of the SYSCTL decode
X816_SYSCTL_OVERLAY = $01          ; bit 0: boot ROM overlay enable
X816_SYSCTL_EMU     = $02          ; bit 1: CPU E flag, read-only
X816_SD_LBA         = $9F81        ; $9F81-$9F84 block number, LE
X816_SD_MEM         = $9F85        ; $9F85-$9F87 DMA address, LE (READ only)
X816_SD_COUNT       = $9F88        ; blocks to transfer, 1-255
X816_SD_CMD         = $9F89        ; WRITE ONLY. 1 READ 2 WRITE 3 READBUF 4 RESET
X816_SD_STATUS      = $9F8A        ; READ ONLY. b0 busy, b1 error, b7 present
X816_SD_GAP         = $9F8B        ; MUST STAY UNMAPPED -- see sd_block.sv
X816_SD_DATA        = $9F8C        ; block-buffer window, auto-incrementing
X816_KBD_COUNT      = $9F8D        ; keyboard diagnostic counters, $9F8D-$9F8F
X816_TIMER          = $9F90        ; $9F90-$9F93 free-running ms counter, LE
X816_TIMER_LAST     = $9F93        ; reading $9F90 latches bits 31:8
X816_TIMER_DIV      = 8000         ; cpu_clk cycles per tick: 8.000 MHz / 8000 = 1 kHz exactly
X816_TIMER_HZ       = 1000         ; so the unit is a millisecond
X816_BOOT_BASE      = $FF00        ; boot ROM read overlay, bank $00
X816_BOOT_SIZE      = $100         ; and it is exactly one page

; ---- Fast program RAM (doc/BRAM_SWITCH.md)
X816_FAST_BASE  = $010000          ; first byte of BRAM -- also X816_PROG_BASE, which is the point
X816_FAST_LAST  = $04FFFF          ; last byte, bank $04
X816_FAST_SIZE  = $040000          ; 256 KB, four whole banks
X816_FAST_BANKS = 4                ; banks $01-$04
X816_VRAM_SIZE  = $020000          ; VERA is stock 128 KB; it was 352 KB before the trade

; ---- Interrupt hardware
X816_VERA_IEN        = $9F26       ; VERA interrupt enable
X816_VERA_ISR        = $9F27       ; VERA interrupt status; write 1 to clear
X816_VERA_IRQ_VSYNC  = 1
X816_VERA_IRQ_LINE   = 2
X816_VERA_IRQ_SPRCOL = 4
X816_VERA_IRQ_AFLOW  = 8           ; clears by REFILLING, not by ack
X816_VIA_IFR         = 13          ; offset within a VIA: interrupt flags
X816_VIA_IER         = 14          ; offset within a VIA: interrupt enable
X816_YM_TIMER_REG    = 20          ; YM2151 register holding its IRQ resets

; ---- 65816 native vectors
X816_VEC_COP   = $00FFE4
X816_VEC_BRK   = $00FFE6
X816_VEC_ABORT = $00FFE8           ; no source; stays trapping
X816_VEC_NMI   = $00FFEA
X816_VEC_IRQ   = $00FFEE

; ---- Interrupt vector slots
KIRQ_VSYNC           = 0           ; VERA vertical blank
KIRQ_LINE            = 1           ; VERA raster line compare
KIRQ_SPRCOL          = 2           ; VERA sprite collision
KIRQ_AFLOW           = 3           ; VERA audio FIFO low
KIRQ_VIA1            = 4           ; VIA #1 -- timers, SNES pads, I2C to the SMC
KIRQ_VIA2            = 5           ; VIA #2 -- user port
KIRQ_YM              = 6           ; YM2151 timer
KIRQ_SPURIOUS        = 7           ; an IRQ that no enabled source claimed
KIRQ_NMI             = 8           ; SMC NMI request -- edge, nothing to acknowledge
KIRQ_BRK             = 9           ; BRK
KIRQ_COP             = 10          ; COP
KIRQ_SLOTS           = 11          ; slots in the table
KIRQ_SLOT_SIZE       = 4           ; bytes per slot: a 24-bit handler in a power-of-two stride, so the index scales with two shifts and not a multiply
KIRQ_TRAMPOLINE_SIZE = 4           ; `jmp long:` -- opcode plus 24 bits

