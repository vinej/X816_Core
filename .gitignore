# ---- Quartus build outputs -------------------------------------------------
db/
incremental_db/
output_files/
greybox_tmp/
simulation/
*.qws
*.jdi
*.jditmp
*.pin
*.done
*.sof
*.rbf
*.smsg
*.rpt
*.summary
PLLJ_PLLSPE_INFO.txt
compile.log

# Generated by sys/build_id.tcl on every compile -- regenerated, never edited.
build_id.v

# ---- Boot ROM build artifacts ----------------------------------------------
# boot/boot.hex is deliberately NOT ignored: rtl/boot_rom.sv reads it with
# $readmemh, so it must be present for `quartus_sh --flow compile` to work on a
# machine with no cc65 installed.  Everything else here is regenerable by
# `sh boot/build.sh`.
boot/boot.o
boot/boot.rom
boot/boot.lst

# ---- Editor / OS -----------------------------------------------------------
*.bak
*.orig
*~
.vscode/
.DS_Store
Thumbs.db

# Quartus fitter side-output
c5_pin_model_dump.txt
jtag.cdf
boot/vramtest.o
boot/vramtest.rom
releases/
boot/vramtest.hex
boot/sdramtest.hex
boot/sdramtest.o
boot/sdramtest.rom
boot/loadtest.o
boot/loadtest.bin
boot/hello.o
boot/hello.bin
boot/mini.*
boot/kbd.o
boot/kbd.bin

# Quartus compile log left by an interactive build
c5.log

# Conformance-test disk images: regenerate with boot/mksdtest.py and
# boot/mkfat32.py rather than carrying 64 MB in the repository.
boot/*.img

# Assembler output from boot/build.sh. These were listed one file at a time and
# the list has already fallen behind once -- boot/sdtest.o was tracked as
# untracked noise because nobody remembered to add it. Only boot/boot.o is
# exempt: boot.hex is committed so the bitstream builds without cc65, and its
# .o is regenerable, so it stays ignored too.
boot/*.o
boot/*.lst
sim/v2work/
